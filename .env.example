# ===================================================================
# SIGGY BOT ENVIRONMENT VARIABLES
# ===================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git!

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_PUBLIC_KEY=your_public_key_here
DISCORD_GUILD_ID=1164825060440281128

# Discord Server IDs
DISCORD_SERVER_ID=1210468736205852672
RITUAL_GUILD_ID=1210468736205852672

# Discord User Token (for extraction scripts ONLY)
# WARNING: User tokens violate Discord ToS for automation
# Get from: Discord DevTools → Application → Local Storage → token
DISCORD_USER_TOKEN=your_user_token_here

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
EXA_API_KEY=your-exa-key-here

# VPS Configuration
DATA_DIR=/home/ubuntu/siggy-bot/discord-bot/data
