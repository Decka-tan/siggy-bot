# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_PUBLIC_KEY=your_public_key_here
DISCORD_GUILD_ID=1164825060440281128

# Discord Server IDs
RITUAL_GUILD_ID=1210468736205852672
CONTRIBUTIONS_CHANNEL_ID=1314448920633413673
EVENT_CHANNEL_ID=1389298240762937414

# Siggy API Configuration
API_BASE_URL=https://siggy-bot.vercel.app
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Data Persistence (Optional)
# Default: ./data (relative to bot directory)
# For Railway/VPS: Use a persistent path like /app/data
# DATA_DIR=/app/data

# Optional: Restrict to specific channels (comma-separated channel IDs)
# ALLOWED_CHANNELS=channel_id_1,channel_id_2

# ---------------------------------------------------------------------------
# Internal HTTP server (health check + invoice refresh hook)
# ---------------------------------------------------------------------------
# Shared secret required by POST /api/refresh-invoice. The invoice dashboard
# sends it as the x-siggy-token header. If this is unset the endpoint is
# DISABLED rather than left open — set the same value on both sides.
INTERNAL_API_TOKEN=generate_a_long_random_string_here

# The HTTP server binds to loopback only by default. Change this only if
# something outside the VPS genuinely needs to reach it.
# HEALTH_BIND_HOST=127.0.0.1
# PORT=8888

# ---------------------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------------------
# Stored conversation messages older than this are deleted by a nightly job
# (03:30 Asia/Jakarta) and once at boot.
# CONVERSATION_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Slash command registration
# ---------------------------------------------------------------------------
# Commands are only re-registered when their definitions change (Discord
# rate-limits this per day). Set to true to force a re-sync once.
# FORCE_COMMAND_SYNC=true
